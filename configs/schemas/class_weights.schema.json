{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "class_weights.yaml",
  "type": "object",
  "required": ["version", "weights"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  }
}
