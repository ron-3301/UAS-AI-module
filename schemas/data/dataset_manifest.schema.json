{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dataset_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dataset_id", "taxonomy_version", "classes", "root", "splits"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "dataset_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "taxonomy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "root": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" } },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image_dir", "annotation_file", "image_count", "class_counts"],
        "properties": {
          "name": { "enum": ["train", "val", "test", "holdout"] },
          "image_dir": { "type": "string" },
          "annotation_file": { "type": "string" },
          "image_count": { "type": "integer", "minimum": 0 },
          "class_counts": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
