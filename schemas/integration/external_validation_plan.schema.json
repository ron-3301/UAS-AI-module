{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "external_validation_plan.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plan_id", "advisory_only", "checks"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "plan_id": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "advisory_only": { "type": "boolean", "const": true },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "enabled", "parameters"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
          "kind": { "enum": ["mavlink", "camera", "onnx", "tensorrt", "observability"] },
          "enabled": { "type": "boolean" },
          "parameters": { "type": "object" }
        }
      }
    }
  }
}
