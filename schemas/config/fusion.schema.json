{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fusion.yaml",
  "description": "Visible/thermal sensor fusion configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "enabled",
    "method",
    "visible",
    "thermal"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "method": {
      "enum": [
        "late_fusion",
        "weighted_boxes",
        "thermal_fallback",
        "visible_only",
        "thermal_only"
      ]
    },
    "visible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "calibration_file": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "source"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "calibration_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_temperature_delta_c": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_time_delta_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "drop_unsynced": {
          "type": "boolean"
        }
      }
    },
    "fusion_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iou_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_combined_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thermal_fallback_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
