{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "advisory_v1_1.json",
  "description": "Advisory-only UAS AI Module output packet. This schema represents recommendations/status only and does not encode commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp_utc",
    "uas_id",
    "advisory_only",
    "health",
    "detections"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "uas_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "frame_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "advisory_only": {
      "type": "boolean",
      "const": true
    },
    "mission_profile": {
      "enum": [
        "wide_area",
        "tracking",
        "point_targeting",
        "replay",
        "unknown"
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "degraded",
            "invalid"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "camera_stale_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "telemetry_stale_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "ownship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt_msl_m": {
          "type": "number"
        },
        "alt_agl_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "heading_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 360
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class_label",
          "confidence",
          "bbox_xyxy",
          "validity_flag",
          "safety_filters_triggered"
        ],
        "properties": {
          "track_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "global_track_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "class_label": {
            "enum": [
              "Person",
              "Vehicle-Wheeled",
              "Vehicle-Tracked",
              "Aircraft-Rotary",
              "Aircraft-Fixed",
              "Watercraft",
              "Structure-Temp",
              "Unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "bbox_xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          },
          "identification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sublabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "is_civilian": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "geolocation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lat": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -180,
                "maximum": 180
              },
              "alt_msl_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cep_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "covariance": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "prediction": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intent": {
                "enum": [
                  "unknown",
                  "stop",
                  "turn",
                  "approach",
                  "evade",
                  "transit",
                  null
                ]
              },
              "intent_confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "tcpa_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "closest_approach_m": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "risk_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "validity_flag": {
            "type": "boolean"
          },
          "validity_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "safety_filters_triggered": {
            "type": "array",
            "items": {
              "enum": [
                "low_detection_confidence",
                "civilian_suppression",
                "person_below_min_agl",
                "cep_too_large",
                "stale_telemetry",
                "stale_frame",
                "invalid_calibration",
                "invalid_geolocation",
                "none"
              ]
            }
          },
          "source_uas_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_type",
          "advisory_only",
          "validity_flag"
        ],
        "properties": {
          "recommendation_type": {
            "enum": [
              "none",
              "observe",
              "reacquire",
              "scan_poi",
              "continue_monitoring"
            ]
          },
          "advisory_only": {
            "type": "boolean",
            "const": true
          },
          "target_track_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "waypoint": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "alt_agl_m": {
                "type": "number",
                "minimum": 0
              },
              "yaw_deg": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 360
              }
            }
          },
          "validity_flag": {
            "type": "boolean"
          },
          "validity_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "safety_filters_triggered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
