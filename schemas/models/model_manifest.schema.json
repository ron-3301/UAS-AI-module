{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "model_manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifacts"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "path", "backend", "sha256", "input_shape"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
          "role": { "enum": ["detector", "classifier", "domain_discriminator", "behaviour_model"] },
          "path": { "type": "string", "pattern": "\\.(onnx|engine)$" },
          "backend": { "enum": ["onnxruntime", "tensorrt"] },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "input_shape": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": { "type": "integer", "minimum": 1 }
          },
          "class_names": {
            "type": "array",
            "items": { "type": "string" }
          },
          "training_dataset_version": { "type": "string" },
          "metrics": { "type": "object" }
        }
      }
    }
  }
}
