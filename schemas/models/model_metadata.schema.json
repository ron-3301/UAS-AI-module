{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "model_metadata.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "role", "artifact", "sha256", "backend", "input", "outputs"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
    "role": { "enum": ["detector", "classifier", "domain_discriminator", "behaviour_model"] },
    "artifact": { "type": "string", "pattern": "\\.(onnx|engine)$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "backend": { "enum": ["onnxruntime", "tensorrt"] },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shape", "dtype"],
      "properties": {
        "name": { "type": "string" },
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "integer", "minimum": 1 }
        },
        "dtype": { "enum": ["float32", "float16", "uint8", "int8"] }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "shape": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "class_names": { "type": "array", "items": { "type": "string" } },
    "preprocessing": { "type": "object" },
    "export": { "type": "object" }
  }
}
